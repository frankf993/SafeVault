@page
@model LoginModel
@{
    ViewData["Title"] = "Accedi";
}

<h1>Accedi</h1>

<form method="post">
    <div class="error">@Model.ErrorMessage</div>

    <label>Username</label>
    <input asp-for="Input.Username" required />

    <label>Password</label>
    <input asp-for="Input.Password" type="password" required />

    <button type="submit">Accedi</button>
</form>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <p class="success">@Model.SuccessMessage</p>
}
